{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EKSReadCluster",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListNodegroups",
        "eks:ListAddons",
        "eks:ListInsights",
        "eks:DescribeInsight"
      ],
      "Resource": "arn:aws:eks:<region>:<account-id>:cluster/*"
    },
    {
      "Sid": "EKSReadNodegroup",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeNodegroup"
      ],
      "Resource": "arn:aws:eks:<region>:<account-id>:nodegroup/*/*/*"
    },
    {
      "Sid": "EKSReadAddon",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeAddon"
      ],
      "Resource": "arn:aws:eks:<region>:<account-id>:addon/*/*/*"
    },
    {
      "Sid": "AccountLevelReads",
      "Effect": "Allow",
      "Action": [
        "eks:ListClusters",
        "eks:DescribeAddonVersions",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*"
    }
  ]
}
