<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLANTED (build_reproducibility): a system-scoped dependency pointing at a JAR
  checked into the tree (lib/legacy-tax-rules-1.2.jar). The artifact cannot be
  resolved from a repository, so the build is not reproducible from the
  declared toolchain alone.

  PLANTED (framework_modernity): maven.compiler.source/target 1.8 — Java 8,
  whose public support has ended. See README "Planted Blockers".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>orders</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>
  <name>Orders (legacy Liberty, Java 8)</name>

  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <failOnMissingWebXml>false</failOnMissingWebXml>
  </properties>

  <dependencies>
    <!-- Java EE 7 API, provided by the Liberty javaee-7.0 feature -->
    <dependency>
      <groupId>javax</groupId>
      <artifactId>javaee-api</artifactId>
      <version>7.0</version>
      <scope>provided</scope>
    </dependency>

    <!--
      PLANTED (build_reproducibility): unmanaged binary in the tree.
      A system-scoped dependency is not resolvable from any repository, so the
      build depends on a JAR that happens to sit in the working copy.

      The JAR is generated by scripts/build.sh (it is not committed as a
      binary), which keeps the repository source-only while still presenting
      the assessment with a genuine system-scoped, repository-unresolvable
      dependency declaration.
    -->
    <dependency>
      <groupId>com.example.thirdparty</groupId>
      <artifactId>legacy-tax-rules</artifactId>
      <version>1.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/legacy-tax-rules-1.2.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>orders</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!--
            NightlySettlementScheduler.java uses the WebSphere-specific CommonJ
            TimerManager API (commonj.timers.*). Those packages ship with
            traditional WebSphere and are NOT on Open Liberty's classpath, so the
            file cannot compile here.

            It is kept in the source tree on purpose: it is the exercise's
            code-level vendor-coupling evidence, and the assessment's tech-stack
            detection reads the source tree (it does not need the class to
            compile). Excluding it from compilation is what lets the same tree
            still build a deployable WAR for the execution phase.

            Removing this exclusion is one of the Rearchitect work items — see
            app-after, where the scheduler is reimplemented on EE Concurrency
            and compiles normally.
          -->
          <excludes>
            <exclude>**/NightlySettlementScheduler.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>
    </plugins>
  </build>
</project>
