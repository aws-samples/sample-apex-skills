        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/security"
        }
      ]
    },
    "addons": {
      "anyOf": [
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/addons"
        }
      ]
    },
    "observability": {
      "anyOf": [
        {
          "$ref": "#/$defs/unavailable"
        },
