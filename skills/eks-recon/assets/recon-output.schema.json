        },
        {
          "$ref": "#/$defs/iac"
        }
      ]
    },
    "cicd": {
      "anyOf": [
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/cicd"
        }
      ]
    },
    "cluster_insights": {
      "anyOf": [
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/cluster_insights"
        }
      ]
    }
