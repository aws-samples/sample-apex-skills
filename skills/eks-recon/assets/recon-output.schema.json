{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sample-apex-skills:eks-recon:recon-output:eks-recon/2026-11-11",
  "title": "eks-recon YAML facts snapshot",
  "description": "Checks the report block, the shared cluster block, cluster_detail and, for each module that ran, its top-level keys (an object key stays an object even when its facts are unreadable). Deeper shapes are the references' Output Schema sections (SKILL.md Step 4b). report.schema_revision must equal the value SKILL.md sets; change both together.",
  "type": "object",
  "required": [
    "report",
    "cluster"
  ],
  "additionalProperties": false,
  "properties": {
    "report": {
      "type": "object",
      "required": [
        "schema_revision",
        "generated_at",
        "unconfirmed_paths"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_revision": {
          "const": "eks-recon/2026-11-11"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "unconfirmed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "required": [
        "name",
        "region",
        "version",
        "platform_version",
        "endpoint",
        "arn",
        "status",
        "created_at",
        "tags"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "cluster_detail": {
      "type": "object",
      "required": [
        "upgrade_policy",
        "zonal_shift",
        "certificate_authority",
        "health",
        "encryption_config"
      ],
      "properties": {
        "upgrade_policy": {
          "type": "object"
        },
        "zonal_shift": {
          "type": "object"
        },
        "certificate_authority": {
          "type": "object"
        },
        "health": {
          "type": "object"
        },
        "encryption_config": {
          "type": "object"
        }
      }
    },
    "compute": {
      "anyOf": [
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/compute"
        }
      ]
    },
    "networking": {
      "anyOf": [
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/networking"
        }
      ]
